# Required by server routes and data-pipeline scripts.
# Vercel: copy Supabase's transaction pooler URL (port 6543); keep the pooler username/host.
# Local PostgreSQL and persistent pipeline/session clients may use port 5432.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Vercel: PEM from Supabase Dashboard > Database settings > Download certificate.
# Verifies TLS and the server identity. Keep DATABASE_URL free of SSL query parameters
# when this is set; pg's URL options would otherwise override the CA configuration.
# Leave unset for a local PostgreSQL server without TLS. Never disable certificate verification.
DATABASE_SSL_CA=

# Optional: enables Supabase Realtime score updates in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional: Sentry error reports. Public by design (it ships to the browser). Unset = off.
NEXT_PUBLIC_SENTRY_DSN=

# Build-only secret: upload source maps from the shipping Vercel build.
# Required in Vercel Production and Preview; local/CI builds may leave it unset.
# Store in Vercel as Secret (previously Sensitive). Never prefix with NEXT_PUBLIC_ or commit a real token.
SENTRY_AUTH_TOKEN=

# Required for the Vercel cron endpoint in production.
CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Optional Postgres pool limit (defaults to 1 on Vercel and 5 elsewhere).
# Leave unset on Vercel unless measured per-worker queuing justifies a larger pool.
DB_POOL_MAX=

# Optional, temporary cutover gate. Keep unset for normal operation.
FULLCOURT_MAINTENANCE=

# Optional ingest/backfill tuning.
NBA_SEED_SKIP_OT=false
NBA_API_DELAY_SECONDS=1.0

# Optional: base URL for scripts/screenshots.mjs (defaults to http://localhost:3000).
SCREENSHOT_BASE_URL=http://localhost:3000
